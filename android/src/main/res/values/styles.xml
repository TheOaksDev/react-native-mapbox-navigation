<resources>
    <style name="DarkPrimaryManeuverTextAppearance">
        <item name="android:textColor">@color/DarkTextColor</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">30sp</item>
    </style>
    <style name="LightPrimaryManeuverTextAppearance">
        <item name="android:textColor">@color/LightTextColor</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">30sp</item>
    </style>
    <style name="DarkSecondaryManeuverTextAppearance">
        <item name="android:textColor">@color/DarkTextColor</item>
        <item name="android:textSize">25sp</item>
    </style>
    <style name="LightSecondaryManeuverTextAppearance">
        <item name="android:textColor">@color/LightTextColor</item>
        <item name="android:textSize">25sp</item>
    </style>
    <style name="DarkStepDistanceRemainingAppearance">
        <item name="android:textColor">@color/DarkTextColor</item>
        <item name="android:textSize">21sp</item>
    </style>
    <style name="LightStepDistanceRemainingAppearance">
        <item name="android:textColor">@color/LightTextColor</item>
        <item name="android:textSize">21sp</item>
    </style>
    <style name="LightManeuverViewIconAppearance">
        <item name="maneuverTurnIconColor">@color/LightTextColor</item>
        <item name="maneuverTurnIconShadowColor">@color/LightTextColor</item>
    </style>
    <style name="DarkManeuverViewIconAppearance">
        <item name="maneuverTurnIconColor">@color/DarkTextColor</item>
        <item name="maneuverTurnIconShadowColor">@color/DarkTextColor</item>
    </style>
    <style name="DarkProgressViewTextAppearance">
        <item name="android:textColor">@color/DarkTextColor</item>
        <item name="android:textSize">21sp</item>
    </style>
    <style name="LightProgressViewTextAppearance">
        <item name="android:textColor">@color/LightTextColor</item>
        <item name="android:textSize">21sp</item>
    </style>
    <style name="LightActionButtonAppearance">
        <item name="recenterButtonBackground">@drawable/rounded_button_light</item>
        <item name="recenterButtonTextColor">@color/LightTextColor</item>
        <item name="soundButtonBackground">@drawable/rounded_button_light</item>
        <item name="soundButtonTextColor">@color/LightTextColor</item>
        <item name="soundButtonMuteDrawable">@drawable/sound_off_light</item>
        <item name="soundButtonUnmuteDrawable">@drawable/sound_on_light</item>
        <item name="overviewButtonBackground">@drawable/rounded_button_light</item>
        <item name="overviewButtonTextColor">@color/LightTextColor</item>
        <item name="overviewButtonDrawable">@drawable/overview_light</item>
        <item name="recenterButtonDrawable">@drawable/recenter_light</item>
    </style>
    <style name="DarkActionButtonAppearance">
        <item name="recenterButtonBackground">@drawable/rounded_button_dark</item>
        <item name="recenterButtonTextColor">@color/DarkTextColor</item>
        <item name="soundButtonBackground">@drawable/rounded_button_dark</item>
        <item name="soundButtonTextColor">@color/DarkTextColor</item>
        <item name="soundButtonMuteDrawable">@drawable/sound_off_dark</item>
        <item name="soundButtonUnmuteDrawable">@drawable/sound_on_dark</item>
        <item name="overviewButtonBackground">@drawable/rounded_button_dark</item>
        <item name="overviewButtonTextColor">@color/DarkTextColor</item>
        <item name="overviewButtonDrawable">@drawable/overview_dark</item>
        <item name="recenterButtonDrawable">@drawable/recenter_dark</item>
    </style>
</resources>
